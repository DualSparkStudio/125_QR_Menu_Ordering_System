{
  "name": "resort-ordering-system",
  "version": "1.0.0",
  "description": "QR Menu Ordering System - Monorepo",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:app\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:app": "cd guest-app && npm run dev",
    "install:all": "npm install && cd backend && npm install && cd ../guest-app && npm install",
    "build:all": "cd backend && npm run build && cd ../guest-app && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "prisma": "^6.19.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3"
  }
}
